DEEPSEEK_API_KEY=replace_me
TG_BOT_TOKEN=replace_me
TG_CHAT_ID=replace_me
TG_BOT_TOKEN_MONITOR=replace_me
TG_CHAT_ID_MONITOR=replace_me

# Persist all operational and observation state outside the git checkout.
STATE_DIR=/var/lib/stock-news-action
STATE_BACKUP_DIR=/var/lib/stock-news-action/backups
MONITOR_DB_FILE=/var/lib/stock-news-action/monitor.db
RUN_STATUS_FILE=/var/lib/stock-news-action/runtime_status.json
RUN_STATUS_DIR=/var/lib/stock-news-action/runtime_status
METRICS_FILE=/var/lib/stock-news-action/runtime_metrics.json
METRICS_RECENT_RUNS=100
HEALTH_MAX_AGE_MINUTES=30
HEALTH_REQUIRED_MODES=daily,monitor
DB_RETENTION_DAYS=30
DB_BACKUP_RETENTION_DAYS=14
HTTP_GET_MAX_ATTEMPTS=2
HTTP_GET_RETRY_BASE_SECONDS=0.5

# An explicit opt-in: the maintenance run fails if this upload cannot finish.
# Configure this rclone remote on the server; use an encrypted remote for state data.
OFFSITE_BACKUP_ENABLED=false
OFFSITE_BACKUP_RCLONE_TARGET=remote:stock-news-action
OFFSITE_BACKUP_TIMEOUT_SECONDS=120

# Add exceptional exchange closures in YYYY-MM-DD form, separated by commas.
# Weekends are handled automatically.
CN_MARKET_HOLIDAYS=
US_MARKET_HOLIDAYS=

# The monitor timer runs every five minutes with up to 15 seconds of jitter.
PRICE_ALERT_MAX_COMPARISON_GAP_MINUTES=6

# Interactive radar. Radar messages use TG_BOT_TOKEN/TG_CHAT_ID, the same
# primary bot and chat as the daily observation-target tracking.
RADAR_A_SHARE_CODES=600519,000001
RADAR_A_SHARE_MINUTE_CHANGE_PCT=1.5
RADAR_INITIAL_TRACK_MINUTES=10
# First keep the trigger silent. Send only after it stays valid for three
# minutes; a larger reversal during the window is discarded without a message.
RADAR_CONFIRM_AFTER_MINUTES=3
RADAR_CONFIRM_MAX_REVERSAL_PCT=0.5
RADAR_INVALIDATION_PCT=3.0
# The same symbol is initially pushed once per market day. A user can mute a
# symbol from its message for the configured number of days.
RADAR_MAX_CANDIDATES_PER_SYMBOL_PER_SESSION=1
RADAR_SYMBOL_MUTE_DAYS=7

# Optional A-share low-price scout. It now looks for early, liquid strength
# rather than waiting for a large daily gain; it is still only a hot-stock pool.
RADAR_A_SHARE_HOT_POOL_ENABLED=0
RADAR_A_SHARE_HOT_POOL_MIN_PRICE=2
RADAR_A_SHARE_HOT_POOL_MAX_PRICE=30
RADAR_A_SHARE_HOT_POOL_MIN_DAY_CHANGE_PCT=2
RADAR_A_SHARE_HOT_POOL_MAX_DAY_CHANGE_PCT=8
RADAR_A_SHARE_HOT_POOL_MAX_NEW_CANDIDATES=1

# Polygon is optional. Without this key, only configured A-share radar symbols
# run. Do not enable a US radar timer until a Polygon plan/key supports the data
# freshness you require.
POLYGON_API_KEY=replace_me
US_RADAR_MIN_PRICE=1
US_RADAR_MAX_PRICE=5
US_RADAR_MIN_DAY_CHANGE_PCT=3
# Avoid late-stage alerts after a low-priced US stock has already surged.
US_RADAR_MAX_DAY_CHANGE_PCT=15
US_RADAR_MIN_DOLLAR_VOLUME=1000000

# Required for group chats. In a private chat, the configured chat ID is allowed
# automatically. Never place a real user ID in the repository.
TG_INTERACTION_ALLOWED_USER_IDS=replace_me
