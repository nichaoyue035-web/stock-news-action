[Unit]
Description=Send stock-news failure alert for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stockbot
WorkingDirectory=/opt/stock-news-action
EnvironmentFile=/etc/stock-news-action.env
UMask=0077
ExecStart=/opt/stock-news-action/.venv/bin/python main.py failure %i
